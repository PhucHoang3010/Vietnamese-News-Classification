# ============================================
# P2 — Vietnamese News Classification
# Environment Configuration
# ============================================

APP_ENV=development

# API (Phase 6+)
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# Model (Phase 5+)
MODEL_PATH=models/news/v1.0.0/model.pkl
MODEL_VERSION=news-v1.0.0

# Inference (Phase 4+)
MIN_WORDS=10
MAX_TEXT_LENGTH=50000
CONFIDENCE_THRESHOLD=0.70

# Database (Phase 7+)
DATABASE_URL=postgresql://user:password@localhost:5432/news_classifier