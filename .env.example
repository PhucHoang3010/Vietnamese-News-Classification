# ============================================================
# Vietnamese News Classification & Trend Analytics Platform
# Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=vietnamese_news

# Connection used by Docker services.
# "postgres" is the Docker Compose service name.
DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:change-this-password@postgres:5432/vietnamese_news

# ------------------------------------------------------------
# FastAPI
# ------------------------------------------------------------

API_HOST=0.0.0.0
API_PORT=8000

# ------------------------------------------------------------
# Crawler
# ------------------------------------------------------------

PREDICTION_API_URL=http://fastapi:8000

CRAWL_INTERVAL_SECONDS=3600

# Internal token used by the crawler control service.
CRAWLER_CONTROL_TOKEN=change-this-crawler-token

# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------

# Used by the frontend development environment.
VITE_API_BASE_URL=http://localhost:8000