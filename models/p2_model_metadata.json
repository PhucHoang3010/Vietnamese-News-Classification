{
  "project": "Vietnamese News Classification & Trend Analytics Platform",
  "dataset_version": "uvn1-v1.0.0",
  "random_seed": 42,

  "preprocessing": {
    "tokenization": "Underthesea",
    "stopwords": "Vietnamese custom stopwords",
    "stopwords_count": 145,
    "punctuation_removal": true,
    "lowercase": false
  },

  "tfidf": {
    "ngram_range": [1, 2],
    "min_df": 1,
    "sublinear_tf": false,
    "lowercase": false,
    "feature_count": 379168
  },

  "model": {
    "type": "LinearSVC",
    "class_weight": "balanced"
  },

  "training": {
    "train_samples": 2272,
    "validation_samples": 487,
    "classes": [
      "Công đoàn",
      "Giáo dục",
      "Giải trí",
      "Khoa học",
      "Kinh doanh",
      "Pháp luật",
      "Sức khỏe",
      "Thế giới",
      "Thể thao",
      "Thời sự",
      "Xe",
      "Xã hội",
      "Đời sống"
    ]
  },

  "artifacts": {
    "vectorizer": "models/p2_tfidf_vectorizer.joblib",
    "model": "models/p2_linear_svm_balanced.joblib"
  },

  "status": "FINAL_PRODUCTION_MODEL"
}
